{
  "name": "motion-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:offline": "playwright test --project=offline",
    "test:packaging": "node --test scripts/release.test.mjs",
    "check:release": "node scripts/release.mjs --check",
    "build": "npm run typecheck && vite build && node scripts/release.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.18.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  }
}
